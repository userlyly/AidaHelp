# 复制为 .env 后再按环境修改。不要把真实密钥提交到 Git。
AIDAHELP_SERVICE_NAME=AidaHelp
AIDAHELP_VERSION=0.1.0
AIDAHELP_ENVIRONMENT=development
AIDAHELP_DEBUG=false
AIDAHELP_HOST=0.0.0.0
AIDAHELP_PORT=8000
AIDAHELP_API_PREFIX=/api/v1
AIDAHELP_LOG_LEVEL=INFO

# MySQL 由 docker-compose.yml 启动后映射到本机 3307，避免和已有 MySQL 冲突。
# 正式环境请替换用户名和密码，不要把真实密码提交到 Git。
AIDAHELP_DATABASE_URL=mysql+asyncmy://aidahelp:aidahelp@127.0.0.1:3307/aidahelp?charset=utf8mb4
AIDAHELP_DATABASE_ECHO=false
AIDAHELP_DATABASE_POOL_SIZE=10
AIDAHELP_DATABASE_MAX_OVERFLOW=20
AIDAHELP_DATABASE_POOL_RECYCLE=1800
AIDAHELP_DATABASE_CONNECT_TIMEOUT=5
AIDAHELP_DATABASE_AUTO_CREATE_SCHEMA=false

# 阶段 3 默认使用 mock，便于无密钥运行完整聊天链路。
# 接入 DeepSeek 等 OpenAI 兼容服务时改为 openai_compatible，并填写真实 API Key。
AIDAHELP_LLM_PROVIDER=mock
AIDAHELP_LLM_BASE_URL=https://api.deepseek.com
AIDAHELP_LLM_API_KEY=
AIDAHELP_LLM_MODEL=deepseek-chat
AIDAHELP_LLM_TIMEOUT_SECONDS=30
AIDAHELP_LLM_TEMPERATURE=0.2
AIDAHELP_LLM_MAX_TOKENS=512
AIDAHELP_LLM_HISTORY_LIMIT=20

# 阶段 4：知识入库与向量化。Mock Embedding 无需密钥，真实模型需保证维度配置正确。
AIDAHELP_EMBEDDING_PROVIDER=mock
AIDAHELP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AIDAHELP_EMBEDDING_API_KEY=
AIDAHELP_EMBEDDING_MODEL=BAAI/bge-m3
AIDAHELP_EMBEDDING_DIMENSION=256
AIDAHELP_EMBEDDING_BATCH_SIZE=32
AIDAHELP_MILVUS_URI=http://127.0.0.1:19530
AIDAHELP_MILVUS_TOKEN=
AIDAHELP_MILVUS_COLLECTION=aidahelp_knowledge_v1
AIDAHELP_KNOWLEDGE_CHUNK_SIZE=700
AIDAHELP_KNOWLEDGE_CHUNK_OVERLAP=100

# 阶段 5：混合检索、重排和证据置信度。
AIDAHELP_RERANK_PROVIDER=mock
AIDAHELP_RERANK_BASE_URL=https://api.siliconflow.cn/v1
AIDAHELP_RERANK_API_KEY=
AIDAHELP_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AIDAHELP_RERANK_TIMEOUT_SECONDS=30
AIDAHELP_RETRIEVAL_RECALL_TOP_K=50
AIDAHELP_RETRIEVAL_TOP_K=10
AIDAHELP_RERANK_MIN_SCORE=0.30
AIDAHELP_EVIDENCE_CONFIDENCE_THRESHOLD=0.26

# 阶段 6～8：LangGraph、退款 interrupt/resume 与分层上下文。
AIDAHELP_AGENT_ENABLED=true
AIDAHELP_AGENT_MAX_STEPS=6
AIDAHELP_CHECKPOINTER_DB_PATH=data/checkpoints/aidahelp.sqlite
AIDAHELP_MEMORY_RECENT_MESSAGES=12
AIDAHELP_MEMORY_SUMMARY_TRIGGER=24
AIDAHELP_MEMORY_SUMMARY_MAX_CHARS=2000
AIDAHELP_MEMORY_MESSAGE_MAX_CHARS=3000

# 阶段 9：工具注册中心、执行引擎和两台 MCP Server。
AIDAHELP_TOOL_DEFAULT_TIMEOUT=5
AIDAHELP_MCP_TOOL_TIMEOUT=10
AIDAHELP_TOOL_MAX_RETRIES=1
AIDAHELP_TOOL_RESULT_MAX_CHARS=6000
AIDAHELP_MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
AIDAHELP_MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp

# 阶段 10：权限与安全。生产环境务必替换 AUTH_SECRET，并关闭 DEMO_AUTH_ENABLED。
AIDAHELP_AUTH_ENABLED=true
AIDAHELP_AUTH_SECRET=change-me-before-production-aidahelp
AIDAHELP_AUTH_ISSUER=aidahelp
AIDAHELP_AUTH_AUDIENCE=aidahelp-api
AIDAHELP_AUTH_TOKEN_TTL_MINUTES=120
AIDAHELP_DEMO_AUTH_ENABLED=true
AIDAHELP_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AIDAHELP_MAX_REQUEST_BODY_BYTES=65536
# 同源部署可留空；跨域时使用英文逗号分隔完整 Origin，例如 https://service.example.com
AIDAHELP_CORS_ALLOWED_ORIGINS=
AIDAHELP_GUARDRAILS_ENABLED=true
